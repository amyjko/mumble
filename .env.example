# Copy to `.env` and fill in. Both are PUBLIC (publishable) values by
# definition — they are shipped to the browser — so they are not secrets. Real
# secrets live in the host's secret store and in CI, never in the repo
# (AR-DEPLOY-6).
#
# These exist as much for the TYPE SYSTEM as for the runtime: SvelteKit
# generates the types for `$env/static/public` from whatever variables are
# actually present, so a missing .env makes `PUBLIC_SUPABASE_URL` untyped and
# lint fails across every file that touches it. CI copies this file for exactly
# that reason.
#
# Local values come from `pnpm supabase:start`, which prints them on startup.
# The placeholder below is NOT a working key — it exists so `$env/static/public`
# is typed in a checkout that has never run Supabase. Anything that actually
# talks to the stack (the app, the integration suite) needs the real value:
#
#   supabase status -o env | grep PUBLISHABLE_KEY
PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_local_placeholder

# SERVER-SIDE SECRET. Never shipped to the browser, never committed with a
# value. Needed by the E2E sign-in helper (which mints a real magic link) and,
# from Phase 5, by the mutation route. Local value:
#
#   supabase status -o env | grep SECRET_KEY
#
# In production it lives in the host's secret store and in CI (AR-DEPLOY-6).
SUPABASE_SECRET_KEY=

# SERVER-SIDE SECRET. Signs publish grants (AR-MEDIA-2); a base64 private JWK
# for ECDSA P-256. Peers verify with the public half from /api/media/key, which
# is why this must be STORED rather than generated: Workers run many isolates,
# and a key minted at cold start differs per isolate, so grants would fail to
# verify intermittently — presenting as "video sometimes doesn't connect".
#
# Left empty here on purpose. Against a LOCAL Supabase the server falls back to
# a FIXED development key committed in `src/lib/server/media-key.ts` — public by
# design, and the reason a local stack is deterministic. It used to generate an
# ephemeral one per isolate, which meant the key route and the session route
# could disagree within a single page load: every peer then refused every offer
# with a signature failure that looked exactly like a network problem.
#
# Pointed anywhere else the server refuses to start a session rather than sign
# with a key nobody else has, so this MUST be set for any deployment. Mint one
# with:
#
#   node -e "crypto.subtle.generateKey({name:'ECDSA',namedCurve:'P-256'},true,['sign','verify']).then(async k=>console.log(Buffer.from(JSON.stringify(await crypto.subtle.exportKey('jwk',k.privateKey))).toString('base64')))"
MEDIA_SIGNING_KEY=

# OAuth providers offered on the sign-in page (UX-ID-7, AR-AUTH-4). A
# comma-separated allowlist; today the only supported name is `google`.
#
# Empty here on purpose, and that is the correct LOCAL experience rather than a
# degraded one: there is no mock OAuth provider in the Supabase CLI (AR-TEST-8),
# so a button rendered locally could only ever produce an error. With this unset
# the page offers magic link alone, and an unknown name is dropped rather than
# thrown on — a typo must cost one button, not the whole sign-in route.
#
# This gates the BUTTON. The credentials themselves live in the Supabase
# project's auth configuration and never reach this worker, which is why there
# is no client id here to sniff for and why the allowlist has to be explicit.
OAUTH_PROVIDERS=

# The Google OAuth credentials, read by supabase/config.toml via env()
# substitution — SERVER-SIDE SECRETS, never committed with a value, and in
# production they live in the host's secret store (AR-DEPLOY-6). Needed only if
# you are actually exercising the handshake against a real Google project;
# nothing in the local suite does.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# TURN relay (AR-TRANSPORT-8), for the ~10-15% of connections that cannot go
# direct. Optional: with both unset the session hands out STUN only, which is
# honest locally — two browsers on one machine never leave it, so the relay path
# has ZERO local coverage (AR-TEST-10). It is also the MVP's only media spend,
# which is why AR-COST-9 watches the relay fraction from the first week.
TURN_SHARED_SECRET=
TURN_URLS=
