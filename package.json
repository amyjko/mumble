{
	"name": "mumble",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"packageManager": "pnpm@11.13.1",
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "wrangler types --check && vite build",
		"preview": "wrangler dev .svelte-kit/cloudflare/_worker.js --port 4173",
		"prepare": "svelte-kit sync || echo ''",
		"gen": "wrangler types",
		"check": "pnpm run check:ts && pnpm run check:svelte",
		"check:ts": "node_modules/ts7/bin/tsc --noEmit",
		"check:svelte": "wrangler types && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"supabase:start": "supabase start",
		"supabase:stop": "supabase stop",
		"supabase:reset": "supabase db reset",
		"test:unit": "vitest",
		"test:rls": "supabase test db",
		"test": "pnpm run test:unit -- --run && pnpm run test:e2e",
		"test:e2e": "playwright install && playwright test"
	},
	"devDependencies": {
		"@playwright/test": "^1.60.0",
		"@sveltejs/adapter-cloudflare": "^7.2.0",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@vitest/browser-playwright": "^4.1.0",
		"playwright": "^1.60.0",
		"svelte": "^5.56.0",
		"svelte-check": "^4.6.0",
		"ts7": "npm:typescript@^7.0.0",
		"typescript": "^6.0.0",
		"vite": "^8.0.0",
		"vitest": "^4.1.0",
		"vitest-browser-svelte": "^3.0.0",
		"wrangler": "^4.100.0"
	},
	"dependencies": {
		"@supabase/ssr": "^0.12.0",
		"@supabase/supabase-js": "^2.100.0"
	}
}
